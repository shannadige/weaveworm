{
  "description": "Deny Read, Glob, Grep, and Bash paths that reach into the plugin checkout outside references/ and skills/, and name the working directory when a skill loads; project files live under the working directory.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-plugin-root.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-plugin-root.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
